#!/usr/bin/env python3
"""Run one agent process in a fresh container on this sandbox host.

The Clyde server reaches this script through an SSH key whose authorized_keys
entry forces it as the command. SSH_ORIGINAL_COMMAND is `run <payload>`, where
the payload is base64 JSON: {"dir": <worktree dir>, "command": <cli>, "args": [...]}.
The script mounts only `dir`, which must sit under the worktree root, and runs
only an allowed CLI. Standard input and output pass straight through.
"""
import base64
import json
import os
import re
import secrets
import sys

WORKTREE_ROOT = "/opt/clyde/worktrees"
HOME_ROOT = os.path.expanduser("~/.local/share/clyde/homes")
IMAGE = os.environ.get("CLYDE_SANDBOX_IMAGE", "clyde-sandbox:latest")
NETWORK = os.environ.get("CLYDE_SANDBOX_NETWORK", "clyde-sandbox")
GATEWAY = "http://model-gateway:8080"
EGRESS = "http://public-egress:8083"
ALLOWED = {"codex", "claude"}
SEGMENT = re.compile(r"^[A-Za-z0-9._-]+$")

CODEX_GATEWAY_ARGS = [
    "-c", 'model_provider="gateway"',
    "-c", f'model_providers.gateway={{name="Gateway",base_url="{GATEWAY}/openai/v1",wire_api="responses"}}',
]


def with_gateway(args):
    """Put the gateway flags right after Codex's subcommand. A `-c` after the
    subcommand replaces the root `-c` flags, so the gateway flags must sit
    there too, before any `-c` the caller passes."""
    if args and not args[0].startswith("-"):
        return [args[0], *CODEX_GATEWAY_ARGS, *args[1:]]
    return [*CODEX_GATEWAY_ARGS, *args]


def refuse(message):
    sys.stderr.write(f"clyde-sandbox-exec: {message}\n")
    sys.exit(126)


def parse(original):
    parts = original.split(" ", 1)
    if len(parts) != 2 or parts[0] != "run":
        refuse("expected `run <payload>`")
    try:
        payload = json.loads(base64.b64decode(parts[1], validate=True))
    except Exception:
        refuse("payload is not base64 JSON")
    directory, command, args = payload.get("dir"), payload.get("command"), payload.get("args", [])
    if not isinstance(directory, str) or not isinstance(command, str) or not isinstance(args, list):
        refuse("payload needs dir, command and args")
    if not all(isinstance(arg, str) for arg in args):
        refuse("every arg must be a string")
    return directory, command, args


def project_of(directory):
    real = os.path.realpath(directory)
    if not real.startswith(WORKTREE_ROOT + "/"):
        refuse("dir must sit under the worktree root")
    segments = real[len(WORKTREE_ROOT) + 1 :].split("/")
    if not all(SEGMENT.match(segment) for segment in segments):
        refuse("dir has an unsafe path segment")
    if not os.path.isdir(real):
        refuse("dir does not exist")
    return real, segments[0]


def main():
    directory, command, args = parse(os.environ.get("SSH_ORIGINAL_COMMAND", ""))
    if command not in ALLOWED:
        refuse(f"command must be one of {sorted(ALLOWED)}")
    real, project = project_of(directory)
    home = os.path.join(HOME_ROOT, project)
    os.makedirs(home, exist_ok=True)
    cli = [command, *with_gateway(args)] if command == "codex" else [command, *args]
    docker = [
        "docker", "run", "--rm", "-i",
        "--name", f"clyde-sbx-{project}-{secrets.token_hex(4)}",
        "--network", NETWORK,
        "--user", "1000:1000",
        "--cap-drop", "ALL",
        "--security-opt", "no-new-privileges",
        "--pids-limit", "1024",
        "-e", "HOME=/home/agent",
        "-e", f"HTTP_PROXY={EGRESS}", "-e", f"HTTPS_PROXY={EGRESS}",
        "-e", f"http_proxy={EGRESS}", "-e", f"https_proxy={EGRESS}",
        "-e", "NO_PROXY=model-gateway", "-e", "no_proxy=model-gateway",
        "-v", f"{home}:/home/agent",
        "-v", f"{real}:{real}",
        "-w", real,
        IMAGE,
        *cli,
    ]
    os.execvp("docker", docker)


if __name__ == "__main__":
    main()
